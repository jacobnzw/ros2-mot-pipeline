  "panels": [
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Raw detector inference latency samples, binned by Grafana into 5-second time buckets and 25 latency buckets.",
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 14,
        "w": 16,
        "x": 0,
        "y": 10
      },
      "id": 1,
      "maxDataPoints": 20000,
      "options": {
        "calculate": true,
        "cellGap": 1,
        "color": {
          "exponent": 0.5,
          "fill": "dark-orange",
          "mode": "scheme",
          "scale": "exponential",
          "scheme": "Oranges",
          "steps": 64
        },
        "legend": {
          "show": true
        },
        "rowsFrame": {
          "layout": "auto"
        },
        "showValue": "never",
        "tooltip": {
          "show": true,
          "yHistogram": false,
          "yHistogramBuckets": 50
        },
        "xAxis": {
          "mode": "time",
          "name": "Time"
        },
        "xBucket": {
          "mode": "size",
          "value": "5s"
        },
        "yAxis": {
          "axisPlacement": "left",
          "decimals": null,
          "max": null,
          "min": 0,
          "name": "Inference latency",
          "reverse": false,
          "unit": "ms"
        },
        "yBucket": {
          "mode": "count",
          "value": 25
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "latency_ms{run=\"$run\", stage=\"detector_inference\"}",
          "interval": "100ms",
          "legendFormat": "inference latency",
          "range": true,
          "refId": "A"
        }
      ],
      "title": "Detector inference latency heatmap",
      "type": "heatmap"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "victoriametrics"
      },
      "description": "Rolling percentiles of inference latency over the preceding five seconds.",
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "showPoints": "never"
          },
          "unit": "ms"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 9,
        "w": 16,
        "x": 0,
        "y": 24
      },
      "id": 2,
      "maxDataPoints": 20000,
      "options": {
        "legend": {
          "calcs": [
            "lastNotNull",
            "max"
          ],
          "displayMode": "table",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi",
          "sort": "asc"
        }
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.50, latency_ms{run=\"$run\", stage=\"detector_inference\"}[5s])",
          "interval": "100ms",
          "legendFormat": "p50",
          "range": true,
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.95, latency_ms{run=\"$run\", stage=\"detector_inference\"}[5s])",
          "interval": "100ms",
          "legendFormat": "p95",
          "range": true,
          "refId": "B"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "editorMode": "code",
          "expr": "quantile_over_time(0.99, latency_ms{run=\"$run\", stage=\"detector_inference\"}[5s])",
          "interval": "100ms",
          "legendFormat": "p99",
          "range": true,
          "refId": "C"
        }
      ],
      "title": "Inference latency percentiles (rolling 5 s)",
      "type": "timeseries"
    },
    {
